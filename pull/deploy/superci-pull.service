[Unit]
Description=superci-pull: the superci-pull-4cpu runner scale set on EC2
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=/etc/superci-pull.env
ExecStart=/usr/local/bin/superci-pull $FLAGS
DynamicUser=yes
StateDirectory=superci-pull
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
