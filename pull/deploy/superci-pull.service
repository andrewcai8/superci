[Unit]
Description=superci-pull: the superci-<N>cpu runner scale sets on EC2
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=/etc/superci-pull.env
ExecStart=/usr/local/bin/superci-pull $FLAGS
DynamicUser=yes
StandardOutput=append:/var/log/superci-pull/listener.jsonl
StandardError=append:/var/log/superci-pull/listener.jsonl
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
