{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ReadAndWriteTheIdentityFiles", "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::@BUCKET@/@DEPLOYMENT@/*" },
    { "Sid": "ListTheIdentityFiles", "Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::@BUCKET@",
      "Condition": { "StringLike": { "s3:prefix": "@DEPLOYMENT@/*" } } },
    { "Sid": "EncryptAndDecryptTheIdentityFiles", "Effect": "Allow", "Action": ["kms:Encrypt", "kms:Decrypt", "kms:GenerateDataKey"], "Resource": "@KEY_ARN@",
      "Condition": { "StringEquals": { "kms:ViaService": "s3.us-east-1.amazonaws.com" },
                     "StringLike": { "kms:EncryptionContext:aws:s3:arn": "arn:aws:s3:::@BUCKET@/@DEPLOYMENT@/*" } } },
    { "Sid": "ReadTheReleasedShim", "Effect": "Allow", "Action": "s3:GetObject",
      "Resource": ["arn:aws:s3:::@RELEASE@/bin/superci-shim", "arn:aws:s3:::@RELEASE@/bin/RELEASE.json"] },
    { "Sid": "PublishWhoPollsGitHub", "Effect": "Allow", "Action": "cloudwatch:PutMetricData", "Resource": "*",
      "Condition": { "StringEquals": { "cloudwatch:namespace": "superci-pull" } } },
    { "Sid": "ReadItsOwnGroup", "Effect": "Allow", "Action": "autoscaling:DescribeAutoScalingInstances", "Resource": "*" },
    { "Sid": "MarkItselfUnhealthy", "Effect": "Allow", "Action": "autoscaling:SetInstanceHealth",
      "Resource": "arn:aws:autoscaling:us-east-1:@ACCOUNT@:autoScalingGroup:*:autoScalingGroupName/superci-pull-identity-*" }
  ]
}
