#!/usr/bin/env -S python3 -I
"""The aws CLI as release_test.sh needs it: S3 objects and Lambda code kept under $FAKE_AWS, every call logged to
$FAKE_AWS/calls.log, and any other call answered as success (an id for a --query, 1 for a length)."""
import base64, hashlib, json, os, shutil, sys

root = os.environ["FAKE_AWS"]
args = sys.argv[1:]
with open(os.path.join(root, "calls.log"), "a") as log:
    log.write(" ".join(args) + "\n")


def opt(name, default=None):
    return args[args.index(name) + 1] if name in args else default


pos = []
skip = False
for i, a in enumerate(args):
    if skip:
        skip = False
        continue
    if a in ("--quiet", "--only-show-errors", "--with-decryption", "--recursive"):
        continue
    if a.startswith("--"):
        skip = True
        continue
    pos.append(a)


def path(url):
    bucket, _, key = url[len("s3://"):].partition("/")
    return os.path.join(root, "s3", bucket, key)


def keys(bucket, prefix):
    base = os.path.join(root, "s3", bucket)
    out = []
    for d, _, fs in os.walk(base):
        for f in fs:
            k = os.path.relpath(os.path.join(d, f), base)
            if k.startswith(prefix):
                out.append(k)
    return sorted(out)


def world():
    f = os.path.join(root, "templates-" + opt("--region", "us-east-1") + ".json")
    return json.load(open(f)) if os.path.isfile(f) else {}


svc, cmd = pos[0], pos[1] if len(pos) > 1 else ""
if svc == "sts":
    print("243891825325")
elif svc == "s3" and cmd == "cp":
    src, dst = pos[2], pos[3]
    if src.startswith("s3://"):
        if not os.path.isfile(path(src)):
            sys.stderr.write("fatal error: An error occurred (404) when calling the HeadObject operation\n")
            sys.exit(1)
        if dst == "-":
            sys.stdout.buffer.write(open(path(src), "rb").read())
        else:
            shutil.copyfile(path(src), dst)
    else:
        os.makedirs(os.path.dirname(path(dst)), exist_ok=True)
        data = sys.stdin.buffer.read() if src == "-" else open(src, "rb").read()
        open(path(dst), "wb").write(data)
elif svc == "s3" and cmd == "rm":
    os.remove(path(pos[2]))
elif svc == "s3api" and cmd == "list-objects-v2":
    if os.path.exists(os.path.join(root, "fail-list")):
        sys.exit(255)
    ks = keys(opt("--bucket"), opt("--prefix", ""))
    print("\t".join(ks) if ks else "None")
elif svc == "s3api" and cmd == "head-object":
    sys.exit(0 if os.path.isfile(os.path.join(root, "s3", opt("--bucket"), opt("--key"))) else 254)
elif svc == "s3api" and cmd == "get-bucket-policy":
    print('{"Condition":{"Null":{"s3:if-none-match":"true"}}}')
elif svc == "lambda":
    state = os.path.join(root, "lambda", opt("--region", "us-east-1"), opt("--function-name", "none"))
    if cmd in ("update-function-code", "create-function"):
        data = open(opt("--zip-file")[len("fileb://"):], "rb").read()
        os.makedirs(os.path.dirname(state), exist_ok=True)
        open(state, "w").write(base64.b64encode(hashlib.sha256(data).digest()).decode())
    elif cmd in ("get-function", "get-function-configuration"):
        if not os.path.isfile(state):
            sys.exit(254)
        if opt("--query") == "CodeSha256":
            print(open(state).read())
elif svc == "ec2" and cmd == "describe-launch-templates" and opt("--output") == "json":
    # templates.sh's world: $FAKE_AWS/templates-<region>.json is {"templates": [{"id", "name", "tags": {k: v}, "default", "latest",
    # "versions": {"<n>": "<image id>"}}], "asg": {"template": id, "version": "$Default"|"$Latest"|"<n>"}, "images": {id:
    # {"OwnerId", "State", "DeprecationTime"}}}; with no file, no templates, no group and every image ours and available.
    w = world()
    print(json.dumps({"LaunchTemplates": [{"LaunchTemplateId": t["id"], "LaunchTemplateName": t["name"], "DefaultVersionNumber": t["default"],
                                           "LatestVersionNumber": t["latest"], "Tags": [{"Key": k, "Value": v} for k, v in t["tags"].items()]}
                                          for t in w.get("templates", [])]}))
elif svc == "ec2" and cmd == "describe-launch-template-versions" and opt("--output") == "json":
    w = world()
    t = next(t for t in w["templates"] if t["id"] == opt("--launch-template-id"))
    vs = args[args.index("--versions") + 1:]
    vs = vs[:next((i for i, a in enumerate(vs) if a.startswith("--")), len(vs))]
    print(json.dumps({"LaunchTemplateVersions": [{"LaunchTemplateId": t["id"], "VersionNumber": int(n), "LaunchTemplateData": {"ImageId": t["versions"][n]}} for n in vs]}))
elif svc == "autoscaling" and cmd == "describe-auto-scaling-groups" and opt("--output") == "json":
    g = world().get("asg")
    print(json.dumps({"AutoScalingGroups": [{"AutoScalingGroupName": "superci-pull-listener", "LaunchTemplate": {"LaunchTemplateId": g["template"], "Version": g["version"]}}] if g else []}))
elif svc == "ec2" and cmd == "describe-images" and opt("--output") == "json":
    img = world().get("images", {}).get(opt("--image-ids"), {"OwnerId": "243891825325", "State": "available"})
    if img is None:
        sys.stderr.write("An error occurred (InvalidAMIID.NotFound) when calling the DescribeImages operation\n")
        sys.exit(254)
    print(json.dumps({"Images": [dict(img, ImageId=opt("--image-ids"))]}))
elif svc == "ec2" and cmd == "describe-images" and opt("--image-ids") is not None:
    # A pin looked up by id: "<owner>\t<state>\t<image id>\t<superci-pull-image tag>" per region in images-<region>; empty,
    # EC2 does not know the id (the CLI exits 254); with no file, our own available copy of the id asked for, of one RunsOn build.
    images = os.path.join(root, "images-" + opt("--region", "us-east-1"))
    if not os.path.isfile(images):
        print("243891825325\tavailable\t%s\t20261120075252" % opt("--image-ids"))
    elif not open(images).read().strip():
        sys.stderr.write("An error occurred (InvalidAMIID.NotFound) when calling the DescribeImages operation\n")
        sys.exit(254)
    else:
        print(open(images).read().strip())
elif svc == "ec2" and cmd == "describe-images":
    # Builds listed by name, as a listener from before the pin looks them up: "<name>\t<image id>" lines in builds-<region>
    # or builds (for all regions); one build of the fleet's image by default.
    builds = os.path.join(root, "builds-" + opt("--region", "us-east-1"))
    builds = builds if os.path.isfile(builds) else os.path.join(root, "builds")
    print(open(builds).read().strip() if os.path.isfile(builds) else "runs-on-v2.2-ubuntu24-full-x64-20261120075252\tami-0parity")
elif svc == "ec2" and cmd == "run-instances":  # the user data a launch is given, kept as the bytes EC2 would take
    ud = opt("--user-data", "")
    scheme, _, f = ud.partition("://")
    data = open(f, "rb").read() if scheme in ("file", "fileb") else ud.encode()
    open(os.path.join(root, "user-data"), "wb").write(data)
    open(os.path.join(root, "user-data.scheme"), "w").write(scheme + "\n")
    print("i-0parity")
elif svc == "ec2" and cmd == "terminate-instances" and os.path.exists(os.path.join(root, "fail-terminate-once")):
    os.remove(os.path.join(root, "fail-terminate-once"))
    sys.stderr.write("An error occurred (RequestLimitExceeded) when calling the TerminateInstances operation\n")
    sys.exit(254)
elif opt("--query") is not None:
    print("1" if opt("--query").startswith("length(") else "stub-id")
