#!/bin/bash
# sleep, without sleeping: every wait of the scripts under test is logged to $FAKE/sleep.log, and moves the test's
# clock ($FAKE/clock, read by the fake date) on by as much.
echo "$*" >> "$FAKE/sleep.log"
clock=$FAKE/clock
[ -s "$clock" ] || /bin/date +%s.%N > "$clock"
awk -v c="$(cat "$clock")" -v s="${1:-0}" 'BEGIN { printf "%.6f\n", c + s }' > "$clock.new" && mv "$clock.new" "$clock"
