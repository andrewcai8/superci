{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LaunchFromRunnerTemplates",
      "Effect": "Allow",
      "Action": ["ec2:CreateFleet", "ec2:RunInstances"],
      "Resource": "arn:aws:ec2:*:243891825325:launch-template/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/purpose": "superci-pull" } }
    },
    {
      "Sid": "LaunchTaggedMachines",
      "Effect": "Allow",
      "Action": ["ec2:CreateFleet", "ec2:RunInstances"],
      "Resource": ["arn:aws:ec2:*:243891825325:instance/*", "arn:aws:ec2:*:243891825325:fleet/*"],
      "Condition": { "StringEquals": { "aws:RequestTag/purpose": "superci-pull" } }
    },
    {
      "Sid": "LaunchTheRunnersImage",
      "Effect": "Allow",
      "Action": ["ec2:CreateFleet", "ec2:RunInstances"],
      "Resource": "arn:aws:ec2:*::image/*",
      "Condition": { "StringEquals": { "ec2:Owner": ["135269210855", "243891825325"] } }
    },
    {
      "Sid": "LaunchIntoOurSecurityGroups",
      "Effect": "Allow",
      "Action": ["ec2:CreateFleet", "ec2:RunInstances"],
      "Resource": "arn:aws:ec2:*:243891825325:security-group/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/purpose": "superci-pull" } }
    },
    {
      "Sid": "LaunchVolumesAndNetwork",
      "Effect": "Allow",
      "Action": ["ec2:CreateFleet", "ec2:RunInstances"],
      "Resource": [
        "arn:aws:ec2:*:243891825325:volume/*",
        "arn:aws:ec2:*:243891825325:subnet/*",
        "arn:aws:ec2:*:243891825325:network-interface/*",
        "arn:aws:ec2:*:243891825325:spot-instances-request/*"
      ]
    },
    {
      "Sid": "MakeRunnerTemplates",
      "Effect": "Allow",
      "Action": "ec2:CreateLaunchTemplate",
      "Resource": "arn:aws:ec2:*:243891825325:launch-template/*",
      "Condition": { "StringEquals": { "aws:RequestTag/purpose": "superci-pull" } }
    },
    {
      "Sid": "ChangeRunnerTemplates",
      "Effect": "Allow",
      "Action": ["ec2:CreateLaunchTemplateVersion", "ec2:ModifyLaunchTemplate", "ec2:DeleteLaunchTemplate"],
      "Resource": "arn:aws:ec2:*:243891825325:launch-template/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/purpose": "superci-pull" } }
    },
    {
      "Sid": "NeverTheListenersOwnTemplate",
      "Effect": "Deny",
      "Action": ["ec2:CreateFleet", "ec2:RunInstances", "ec2:CreateLaunchTemplateVersion", "ec2:ModifyLaunchTemplate", "ec2:DeleteLaunchTemplate"],
      "Resource": "arn:aws:ec2:*:243891825325:launch-template/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/superci-pull-role": "listener" } }
    },
    {
      "Sid": "TagOnlyWhileCreating",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateFleet",
            "RunInstances",
            "CreateLaunchTemplate",
            "CreateLaunchTemplateVersion"
          ]
        }
      }
    },
    {
      "Sid": "TagAMachineIssuedOrNoticed",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:*:243891825325:instance/*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/purpose": "superci-pull" },
        "ForAllValues:StringEquals": { "aws:TagKeys": ["superci-pull-issued", "superci-pull-noticed"] }
      }
    },
    {
      "Sid": "EndOnlyOurs",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/purpose": "superci-pull"
        }
      }
    },
    {
      "Sid": "TakeTheListenersAddress",
      "Effect": "Allow",
      "Action": "ec2:AssociateAddress",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/purpose": "superci-pull"
        }
      }
    },
    {
      "Sid": "Read",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeImages",
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeVpcs",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeSpotPriceHistory",
        "ec2:DescribeFleets",
        "ec2:DescribeFleetInstances",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeAddresses",
        "autoscaling:DescribeAutoScalingInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassCacheRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::243891825325:role/superci-pull-cache-machine",
      "Condition": { "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" } }
    },
    {
      "Sid": "MarkItselfUnhealthy",
      "Effect": "Allow",
      "Action": "autoscaling:SetInstanceHealth",
      "Resource": "arn:aws:autoscaling:us-east-1:243891825325:autoScalingGroup:*:autoScalingGroupName/superci-pull-listener"
    },
    {
      "Sid": "Parameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:243891825325:parameter/superci-pull/github-app",
        "arn:aws:ssm:us-east-1:243891825325:parameter/superci-pull/tls",
        "arn:aws:ssm:us-east-1:243891825325:parameter/superci-pull/spend",
        "arn:aws:ssm:us-east-1:243891825325:parameter/superci-pull/pool"
      ]
    },
    {
      "Sid": "KeepTlsKeyAndSpend",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:AddTagsToResource"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:243891825325:parameter/superci-pull/tls",
        "arn:aws:ssm:us-east-1:243891825325:parameter/superci-pull/spend",
        "arn:aws:ssm:us-east-1:243891825325:parameter/superci-pull/pool"
      ]
    },
    {
      "Sid": "Release",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::superci-pull-243891825325",
        "arn:aws:s3:::superci-pull-243891825325/*"
      ]
    },
    {
      "Sid": "Claims",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::superci-pull-claims-243891825325/issued/*"
    },
    {
      "Sid": "ClaimsBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::superci-pull-claims-243891825325"
    },
    {
      "Sid": "Metrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "superci-pull"
        }
      }
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:243891825325:log-group:/superci-pull/listener",
        "arn:aws:logs:us-east-1:243891825325:log-group:/superci-pull/listener:*"
      ]
    },
    {
      "Sid": "FleetAndSpotRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ec2fleet.amazonaws.com",
            "spot.amazonaws.com"
          ]
        }
      }
    }
  ]
}
