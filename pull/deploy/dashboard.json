{
  "start": "-PT6H",
  "periodOverride": "inherit",
  "widgets": [
    {"type": "alarm", "x": 0, "y": 0, "width": 24, "height": 3, "properties": {"title": "Alarms", "alarms": [
      "arn:aws:cloudwatch:us-east-1:243891825325:alarm:superci-pull-listener-down",
      "arn:aws:cloudwatch:us-east-1:243891825325:alarm:superci-pull-jobs-stalled",
      "arn:aws:cloudwatch:us-east-1:243891825325:alarm:superci-pull-oldest-job-wait",
      "arn:aws:cloudwatch:us-east-1:243891825325:alarm:superci-pull-queue-wait-p90",
      "arn:aws:cloudwatch:us-east-1:243891825325:alarm:superci-pull-registration-refusals",
      "arn:aws:cloudwatch:us-east-1:243891825325:alarm:superci-pull-registration-errors",
      "arn:aws:cloudwatch:us-east-1:243891825325:alarm:superci-pull-orphans",
      "arn:aws:cloudwatch:us-east-1:243891825325:alarm:superci-pull-spend-daily",
      "arn:aws:cloudwatch:us-east-1:243891825325:alarm:superci-pull-spend-capped",
      "arn:aws:cloudwatch:us-east-1:243891825325:alarm:superci-pull-launch-shortfall",
      "arn:aws:cloudwatch:us-east-1:243891825325:alarm:superci-pull-org-rate-unknown"]}},
    {"type": "metric", "x": 0, "y": 3, "width": 12, "height": 6, "properties": {"title": "Queue wait (s) of started jobs", "region": "us-east-1", "view": "timeSeries", "period": 60,
      "metrics": [["superci-pull", "QueueWait", {"stat": "p50", "label": "p50"}], ["...", {"stat": "p90", "label": "p90"}], ["...", {"stat": "p99", "label": "p99"}], ["...", {"stat": "SampleCount", "label": "jobs started", "yAxis": "right"}]]}},
    {"type": "metric", "x": 12, "y": 3, "width": 12, "height": 6, "properties": {"title": "Jobs waiting, per set", "region": "us-east-1", "view": "timeSeries", "period": 60,
      "metrics": [[{"expression": "SEARCH('{superci-pull,Set} MetricName=\"JobsWaiting\"', 'Maximum', 60)", "id": "waiting"}], ["superci-pull", "StalledSets", {"stat": "Maximum", "label": "sets stalled", "yAxis": "right"}]]}},
    {"type": "metric", "x": 0, "y": 9, "width": 12, "height": 6, "properties": {"title": "Machines and runners, per set", "region": "us-east-1", "view": "timeSeries", "period": 60,
      "metrics": [[{"expression": "SEARCH('{superci-pull,Set} MetricName=\"Machines\"', 'Maximum', 60)", "id": "machines"}], [{"expression": "SEARCH('{superci-pull,Set} MetricName=\"IdleRunners\"', 'Maximum', 60)", "id": "idle"}], [{"expression": "SEARCH('{superci-pull,Set} MetricName=\"BusyRunners\"', 'Maximum', 60)", "id": "busy"}]]}},
    {"type": "metric", "x": 12, "y": 9, "width": 12, "height": 6, "properties": {"title": "Registration rates (a second): GitHub's cap is 5 for the whole organization", "region": "us-east-1", "view": "timeSeries", "period": 60,
      "metrics": [["superci-pull", "OrgRegistrationRate", {"stat": "Average"}], [".", "OthersRegistrationRate", {"stat": "Average"}], [".", "OurRegistrationRate", {"stat": "Average"}], [".", "SpareRegistrationRate", {"stat": "Average"}]],
      "annotations": {"horizontal": [{"value": 4, "label": "4/s: the cap less the 20% margin"}]}}},
    {"type": "metric", "x": 0, "y": 15, "width": 12, "height": 6, "properties": {"title": "Registrations a minute", "region": "us-east-1", "view": "timeSeries", "period": 60, "stat": "Sum",
      "metrics": [["superci-pull", "Registrations"], [".", "RegistrationRefusals"], [".", "RegistrationErrors"], [".", "LaunchShortfall"], [".", "Orphans", {"stat": "Maximum"}]]}},
    {"type": "metric", "x": 12, "y": 15, "width": 12, "height": 6, "properties": {"title": "Spend (USD): today against the daily cap, and the hour", "region": "us-east-1", "view": "timeSeries", "period": 300, "stat": "Maximum",
      "metrics": [["superci-pull", "SpendTodayUSD"], [".", "SpendDailyCapUSD"], [".", "SpendPerHourUSD", {"yAxis": "right"}], [".", "OnDemandShare", {"yAxis": "right"}]]}},
    {"type": "log", "x": 0, "y": 21, "width": 24, "height": 6, "properties": {"title": "Listener warnings and errors", "region": "us-east-1", "view": "table",
      "query": "SOURCE '/superci-pull/listener' | fields @timestamp, level, msg, set, machine, err | filter level in ['WARN', 'ERROR'] | sort @timestamp desc | limit 50"}},
    {"type": "log", "x": 0, "y": 27, "width": 12, "height": 6, "properties": {"title": "Timeline: queue wait (s) per set, p50 and p90 of started jobs", "region": "us-east-1", "view": "table",
      "query": "SOURCE '/superci-pull/listener' | filter msg = 'tl' and ev = 'job.started' | stats count(*) as jobs, pct(queue_ms, 50) / 1000 as p50_s, pct(queue_ms, 90) / 1000 as p90_s by set | sort set"}},
    {"type": "log", "x": 12, "y": 27, "width": 12, "height": 6, "properties": {"title": "Timeline: queue wait (s) over time, p50 and p90", "region": "us-east-1", "view": "timeSeries",
      "query": "SOURCE '/superci-pull/listener' | filter msg = 'tl' and ev = 'job.started' | stats pct(queue_ms, 50) / 1000 as p50_s, pct(queue_ms, 90) / 1000 as p90_s by bin(5m)"}},
    {"type": "log", "x": 0, "y": 33, "width": 12, "height": 6, "properties": {"title": "Timeline: boot phases (s) on the machine, p50 and p90 (each phase ends at the mark named)", "region": "us-east-1", "view": "table",
      "query": "SOURCE '/superci-pull/listener' | filter msg = 'tl' and ev in ['cache.start', 'cache.up', 'doc.got', 'jit.sent', 'jit.answered', 'runner.start', 'runner.online'] | stats count(*) as n, pct(dur_ms, 50) / 1000 as p50_s, pct(dur_ms, 90) / 1000 as p90_s by ev | sort p50_s desc"}},
    {"type": "log", "x": 12, "y": 33, "width": 12, "height": 6, "properties": {"title": "Timeline: launch call and registration (s) per set, p50 and p90", "region": "us-east-1", "view": "table",
      "query": "SOURCE '/superci-pull/listener' | filter msg = 'tl' and ev in ['machine.launched', 'jit.issued'] | stats pct(answer_ms, 50) / 1000 as launch_p50_s, pct(answer_ms, 90) / 1000 as launch_p90_s, pct(register_ms, 50) / 1000 as register_p50_s, pct(register_ms, 90) / 1000 as register_p90_s by set | sort set"}},
    {"type": "metric", "x": 0, "y": 39, "width": 12, "height": 6, "properties": {"title": "Waits in progress (s): the oldest job waiting for a runner, and the oldest machine with none", "region": "us-east-1", "view": "timeSeries", "period": 60, "stat": "Maximum",
      "metrics": [["superci-pull", "OldestWaitingJobAgeS", {"label": "oldest waiting job"}], [".", "OldestUnregisteredMachineAgeS", {"label": "oldest machine without a runner"}]],
      "annotations": {"horizontal": [{"value": 60, "label": "60 s: the alarm, two minutes running"}]}}},
    {"type": "metric", "x": 12, "y": 39, "width": 12, "height": 6, "properties": {"title": "Registrations the budget turned away a minute, by reason (GitHub was never asked)", "region": "us-east-1", "view": "timeSeries", "period": 60, "stat": "Sum",
      "metrics": [["superci-pull", "BudgetDenied", "Reason", "window"], ["...", "tokens"], ["...", "throttled"], ["...", "blind"]]}}
  ]
}
