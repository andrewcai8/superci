{
  "agent": { "run_as_user": "root" },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/superci-pull/listener.jsonl", "log_group_name": "/superci-pull/listener", "log_stream_name": "{instance_id}" },
          { "file_path": "/var/log/superci-pull-boot.log", "log_group_name": "/superci-pull/listener", "log_stream_name": "{instance_id}-boot" }
        ]
      }
    }
  }
}
